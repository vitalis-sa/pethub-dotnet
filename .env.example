# Copie para .env e preencha. O .env NÃO vai para o git (está no .gitignore).

# Oracle local (contêiner gvenzl/oracle-free)
ORACLE_SYS_PASSWORD=troque-esta-senha
ORACLE_APP_USER=vitalis
ORACLE_APP_PASSWORD=troque-esta-senha

# Segredos da API (JWT precisa de no mínimo 32 bytes)
JWT_SEGREDO=troque-por-uma-chave-com-pelo-menos-32-caracteres
SERVICE_TOKEN=troque-pelo-mesmo-valor-do-SERVICE_TOKEN-do-java

# Backend Java (opcional: sem ele, o /health responde 503 e o gateway clínico falha)
PETHUB_JAVA_URL=http://host.docker.internal:8080
PETHUB_JAVA_HEALTH_URL=http://host.docker.internal:8080/api-docs

# RabbitMQ (opcional: sem RABBIT_HOST o consumidor de lembretes fica desligado)
# Para o CloudAMQP use porta 5671, RABBIT_SSL=true e RABBIT_VHOST = usuário.
RABBIT_HOST=
RABBIT_PORTA=5672
RABBIT_USUARIO=
RABBIT_SENHA=
RABBIT_VHOST=/
RABBIT_SSL=false

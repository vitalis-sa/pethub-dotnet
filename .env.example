# Copie para .env e preencha. O .env NÃO vai para o git (*.env está no .gitignore).
# O devcontainer carrega este arquivo (--env-file); fora dele, exporte as variáveis no shell.
# Os nomes seguem a convenção do ASP.NET: "Secao__Chave" equivale a "Secao:Chave" no appsettings.json.

# --- Oracle (obrigatório) ---
# Oracle local: docker run -d --name vitalis-oracle -p 1521:1521 -e ORACLE_PASSWORD=troque -e APP_USER=vitalis -e APP_USER_PASSWORD=vitalis gvenzl/oracle-free:23-slim-faststart
ConnectionStrings__OracleConnection=User Id=vitalis;Password=vitalis;Data Source=localhost:1521/FREEPDB1
# Aplica as migrations do EF na subida (padrão true).
Banco__AplicarMigracoes=true

# --- Segredos da API (obrigatórios, mínimo de 32 caracteres cada) ---
Jwt__Segredo=troque-por-uma-chave-com-pelo-menos-32-caracteres
# Mesmo valor do SERVICE_JWT_SECRET do pethub-java.
ServicoAuth__Segredo=troque-pelo-mesmo-segredo-de-servico-do-java

# --- MongoDB (opcional: sem ele o histórico de mensagens fica desligado e o /health mostra Degraded) ---
# MongoDB local: docker run -d --name vitalis-mongo -p 27017:27017 mongo:7
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__Banco=vitalis

# --- Backend Java (opcional: sem ele o /health responde 503 e o gateway clínico falha) ---
PethubJava__UrlBase=http://host.docker.internal:8080
ServicosExternos__PethubJava=http://host.docker.internal:8080/api-docs

# --- RabbitMQ (opcional: sem RabbitMq__Host o consumidor de lembretes fica desligado) ---
# No CloudAMQP: porta 5671, Ssl=true e VirtualHost = usuário.
RabbitMq__Host=
RabbitMq__Porta=5672
RabbitMq__Usuario=
RabbitMq__Senha=
RabbitMq__VirtualHost=/
RabbitMq__Ssl=false
